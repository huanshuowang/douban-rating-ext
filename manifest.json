{
  "manifest_version": 3,
  "name": "这豆瓣评分多少？- 电影/电视剧评分一键查 · Douban Movie & TV Rating",
  "version": "1.1.0",
  "description": "看电影、追剧、刷 B 站解说、逛 Netflix / YouTube 时，点一下就显示豆瓣评分，一键直达豆瓣条目。电影、电视剧、综艺、动漫都能查，中英文片名都认得。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://www.baidu.com/*",
    "https://movie.douban.com/*"
  ],
  "action": {
    "default_title": "查豆瓣评分",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/score/icon16.png",
      "32": "icons/score/icon32.png"
    }
  },
  "icons": {
    "16": "icons/score/icon16.png",
    "32": "icons/score/icon32.png",
    "48": "icons/score/icon48.png",
    "128": "icons/score/icon128.png"
  }
}
